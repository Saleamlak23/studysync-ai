# StudySync AI environment template.
# Copy to apps/api/.env (all variables) and apps/web/.env (VITE_ variables only).
# Never commit a real .env file.

# --- API server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studysync_ai

# --- Auth (use long random strings, different from each other) ---
JWT_SECRET=change-me
REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- AI providers (free keys: console.groq.com and aistudio.google.com) ---
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash

# Default limits; the System Admin can override them in the AppSetting table
AI_USER_DAILY_LIMIT=20
AI_WORKSPACE_DAILY_LIMIT=100

# --- Files stored in PostgreSQL ---
FILE_MAX_BYTES=5242880
WORKSPACE_STORAGE_CAP_BYTES=104857600

# --- Email (optional; local Mailpit defaults, only used by email features) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- Web app (apps/web/.env) ---
VITE_API_URL=http://localhost:4000/api/v1
