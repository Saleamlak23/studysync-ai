// StudySync AI - Prisma schema (from ERD and Data Dictionary v1.0, SDD section 5)
//
// Conventions
// - String ids hold UUIDs generated by Prisma (uuid()).
// - Children of a workspace cascade on delete; authored content keeps its row
//   when the author is deleted (author column set to null).
// - Card.position and List.position are fractional (Float) for conflict-safe ordering.
//
// Full-text search (searchVector) needs a hand-edited migration:
//   1. npx prisma migrate dev --create-only --name init
//   2. In the generated migration.sql, replace the plain "searchVector" tsvector
//      column on "Card" and "Message" with generated columns, e.g.
//        "searchVector" tsvector GENERATED ALWAYS AS (
//          to_tsvector('simple', coalesce("title", '') || ' ' || coalesce("description", ''))
//        ) STORED
//      (Message: to_tsvector('simple', coalesce("content", ''))).
//      The 'simple' configuration does no English stemming, so it is safe for
//      Amharic and mixed-language text.
//   3. Add the indexes at the end of that file:
//        CREATE INDEX "Card_searchVector_idx" ON "Card" USING GIN ("searchVector");
//        CREATE INDEX "Message_searchVector_idx" ON "Message" USING GIN ("searchVector");
//   4. npx prisma migrate dev
//   Query it with $queryRaw (Prisma cannot read Unsupported columns directly).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum SystemRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  ASSIGNED
  MENTION
  DEADLINE
}

enum ReminderType {
  DUE_24H
}

enum AIFeature {
  ASK
  SUMMARIZE
  BREAKDOWN
}

enum AIStatus {
  SUCCESS
  ERROR
}

// ------------------------------------------------- identity and access

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  systemRole   SystemRole @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  memberships   Membership[]
  createdInvites InviteLink[]
  consentedWorkspaces Workspace[]
  createdCards  Card[]
  assignedCards CardAssignee[]
  comments      Comment[]
  messages      Message[]
  uploadedFiles File[]
  notifications Notification[]
  reminders     Reminder[]
  aiLogs        AIRequestLog[]
  updatedSettings AppSetting[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Workspace {
  id            String    @id @default(uuid())
  name          String
  description   String?
  aiEnabled     Boolean   @default(false)
  aiConsentById String?
  aiConsentAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  aiConsentBy   User?          @relation(fields: [aiConsentById], references: [id], onDelete: SetNull)
  memberships   Membership[]
  invites       InviteLink[]
  board         Board?
  labels        Label[]
  channels      Channel[]
  files         File[]
  notifications Notification[]
  aiLogs        AIRequestLog[]
}

model Membership {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model InviteLink {
  id          String    @id @default(uuid())
  workspaceId String
  code        String    @unique
  createdById String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// ---------------------------------------------------------------- board

model Board {
  id          String @id @default(uuid())
  workspaceId String @unique
  name        String @default("Board")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lists     List[]
}

model List {
  id       String @id @default(uuid())
  boardId  String
  name     String
  position Float

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
}

model Card {
  id           String                   @id @default(uuid())
  listId       String
  title        String
  description  String?
  priority     Priority                 @default(MEDIUM)
  dueDate      DateTime?
  position     Float
  createdById  String?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  list      List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignees CardAssignee[]
  labels    CardLabel[]
  comments  Comment[]
  reminders Reminder[]

  @@index([listId, position])
}

model CardAssignee {
  cardId String
  userId String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

model Label {
  id          String @id @default(uuid())
  workspaceId String
  name        String
  color       String

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards     CardLabel[]

  @@unique([workspaceId, name])
}

model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model Comment {
  id        String   @id @default(uuid())
  cardId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  card   Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
}

// ------------------------------------------------ communication and files

model Channel {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([workspaceId, name])
}

model Message {
  id           String                   @id @default(uuid())
  channelId    String
  authorId     String?
  content      String
  fileId       String?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  deletedAt    DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  file    File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt, id])
}

model File {
  id          String   @id @default(uuid())
  workspaceId String
  uploaderId  String?
  name        String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  messages  Message[]
  blob      FileBlob?

  @@index([workspaceId])
}

// File bytes live in their own table so normal File queries never load them.
// Read the bytes only when streaming a download.
model FileBlob {
  fileId String @id
  data   Bytes

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------ notifications and AI

model Notification {
  id          String           @id @default(uuid())
  userId      String
  workspaceId String
  type        NotificationType
  payload     Json
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Reminder {
  id        String       @id @default(uuid())
  cardId    String
  userId    String
  type      ReminderType @default(DUE_24H)
  dueAt     DateTime
  createdAt DateTime     @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId, type, dueAt])
}

// Metadata only: message bodies and prompts are never stored (NFR-14).
model AIRequestLog {
  id          String    @id @default(uuid())
  userId      String?
  workspaceId String
  feature     AIFeature
  provider    String
  tokensIn    Int       @default(0)
  tokensOut   Int       @default(0)
  status      AIStatus
  latencyMs   Int
  createdAt   DateTime  @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
}

// Platform settings the System Admin can change. Current keys:
//   ai.userDailyLimit       (integer, AI requests per user per day)
//   ai.workspaceDailyLimit  (integer, AI requests per workspace per day)
// When a key has no row, the default from configuration applies.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}
